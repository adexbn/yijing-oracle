# 统一换行符策略：仓库内一律存 LF，检出时按平台决定
* text=auto

# Shell 脚本必须保持 LF，否则 Linux/macOS CI 上会因 CRLF 报 "bad interpreter"
gradlew text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.ttf binary
*.jar binary
*.png binary
*.jpg binary
*.ipa binary
*.apk binary
*.aab binary
*.so binary
*.p12 binary
*.mobileprovision binary
