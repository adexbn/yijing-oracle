<?xml version="1.0" encoding="utf-8"?>
<!--
  首次使用初始化页：不走原生 ProgressDialog，自己画一屏。
  中心是「太极 + 环形进度」（走一步画一笔会动的太极，圆环随下载进度生长），
  文案 + 朱砂进度条 + 左侧状态/右侧百分比，提示"首次使用需要初始化"。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="36dp">

        <!-- 太极 + 进度环：与 iOS OnboardingView.ringView 同构（172dp / 太极 108dp） -->
        <com.yijing.app.ui.TaijiProgressView
            android:id="@+id/onboardingTaiji"
            android:layout_width="172dp"
            android:layout_height="172dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.28"
            android:text="周易小卦"
            android:textColor="@color/brand"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/onboardingHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="首次使用需要初始化"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboardingDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="正在准备解卦所需的本地模型"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <!-- 进度整体：条 + 下面一行「左状态 / 右百分比」，与 iOS progressBlock 一致 -->
        <LinearLayout
            android:id="@+id/onboardingProgressBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/onboardingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_cinnabar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/onboardingStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="准备中"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/onboardingPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0%"
                    android:textColor="@color/cinnabar"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/onboardingRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_retry_button"
            android:paddingHorizontal="26dp"
            android:paddingVertical="11dp"
            android:text="重新尝试"
            android:textColor="@color/cinnabar"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 下载中的「取消」：网络不通时不想干等，一击即停。 -->
        <TextView
            android:id="@+id/onboardingCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_cancel_button"
            android:paddingHorizontal="26dp"
            android:paddingVertical="11dp"
            android:text="取消下载"
            android:textColor="@color/ink_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 失败/取消后的出口：先跳过，稍后在设置里下载。 -->
        <TextView
            android:id="@+id/onboardingSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="先跳过，稍后再下载"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="仅需一次　·　完成后可完全离线解卦\n模型存放于 App 数据目录，重装或升级不会重复下载"
        android:textColor="@color/ink_muted"
        android:textSize="11sp" />
</FrameLayout>
